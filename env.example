# ─────────────────────────────────────────────────────────────────────────────
# ALL VARIABLES ARE OPTIONAL.
#
# With NONE set, the app runs in fully functional DEMO mode: an in-memory mock
# database (representative seed data) and a deterministic mock AI provider.
# Deploy to Vercel with zero configuration and the whole product works.
#
# Set the credentials below to switch the SAME code paths to the live services.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — set BOTH to use a real database instead of the in-memory mock.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic — set to use live Claude instead of the deterministic mock provider.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Application — production domain for OpenGraph/Twitter metadata.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
